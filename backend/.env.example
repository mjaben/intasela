# Intasela Backend — Environment Variables
# Copy this file to .env and fill in real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/intasela"

# JWT secret — generate a strong one: openssl rand -base64 64
JWT_SECRET="generate-a-strong-secret-here"

# Redis (for BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Frontend URLs (for CORS)
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

# Server port
PORT=3001

# Platform Activity Simulator Settings
SIMULATOR_ENABLED=false
SIMULATOR_MIN_INTERVAL_MINUTES=20
SIMULATOR_MAX_INTERVAL_MINUTES=60
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
